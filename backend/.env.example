# Copy this file to .env and fill in real values. Never commit .env.

# Development database (PostgreSQL on this machine, not in Docker)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/delivery_db

# Test database. Tests drop and recreate its tables, so it must be a separate
# database and its name must contain "test".
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/test_delivery_db

# Redis from docker-compose.yml (readiness checks now; pub/sub and rate limiting later)
REDIS_URL=redis://localhost:6380/0

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# Optional
# LOG_LEVEL=INFO
# LOG_JSON=true      # false gives readable one-line logs in development
# SQL_ECHO=false     # true logs every SQL statement
