# Copy this file to .env and fill in real values. Never commit .env.

# Development database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/delivery_db

# Test database. Tests drop and recreate its tables, so it must be a separate
# database and its name must contain "test".
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/test_delivery_db

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
